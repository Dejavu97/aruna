# ================= ARUNA UNDANGAN — ENVIRONMENT =================
# Satu-satunya variabel yang dibutuhkan serverless (api/*.js, Vercel):
FIREBASE_SERVICE_ACCOUNT=

# YANG BUKAN ENV (jangan cari/ditambahkan di sini):
# - Firebase client config → inline di src/lib/firebase.js (publik by design)
# - Upload gambar → Cloudinary unsigned preset, hardcode di src/lib/api.js (uploadFile)
# - Password admin → TIDAK lewat env. Kelola lewat panel /admin (Ganti Password),
#   tersimpan ter-hash (scrypt) di Firestore settings/admin_auth.
