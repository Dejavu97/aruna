rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. KOLEKSI UNDANGAN (/invitations)
    // =========================================================================
    match /invitations/{slug} {
      // Tamu publik & pengantin bebas membuka undangan
      allow read: if true;

      // Creation selalu melalui /api/create-invitation agar public data,
      // private metadata, dan edit key dibuat atomik oleh Admin SDK.
      allow create: if false;

      // Semua client update wajib mempertahankan status pembayaran dan tidak
      // boleh menulis metadata private/order ke dokumen publik.
      allow update: if
        request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'customerWhatsapp',
          'customerEmail',
          'customerNote',
          'orderCode',
          'voucher',
          'guests',
          'checkIns',
          'waTemplate',
          'waReminderTemplate',
          'ownerUid',
          'adFree',
          'whiteLabel',
          'hideWatermark',
          'paymentStatus',
          'paidAt',
          'isPaid',
          'watermarkMode',
          'customWatermarkText',
          'customWatermarkUrl',
          'rsvps',
          'wishes',
          'customDomain'
        ]) == false
        && (
          // Owner Google hanya dapat mengubah dokumennya sendiri.
          (request.auth != null && resource.data.ownerUid == request.auth.uid)
          // Admin Google tetap boleh mengedit konten, tetapi status hanya lewat API.
          || (request.auth != null && request.auth.token.email == 'admin@byaruna.my.id')
          // View counter tetap boleh bertambah dari renderer publik. RSVP dan
          // wishes hanya boleh ditulis melalui /api/guestbook.
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['views'])
            && request.resource.data.views == resource.data.views + 1
          )
        );

      // Delete lifecycle selalu melalui /api/delete-invitation agar public,
      // private metadata, dan key terhapus dalam satu atomic batch.
      allow delete: if false;
    }

    // =========================================================================
    // 2. BRANKAS KUNCI RAHASIA (/private_keys)
    // =========================================================================
    match /private_keys/{slug} {
      allow read, write: if false;
    }

    // Metadata order/customer hanya dibaca dan ditulis serverless Admin SDK.
    match /invitation_private/{slug} {
      allow read, write: if false;
    }

    // =========================================================================
    // 3. ULASAN & TESTIMONI PELANGGAN (/testimonials)
    // =========================================================================
    match /testimonials/{id} {
      allow read: if true;
      allow create: if (request.resource.data.stars >= 1 && request.resource.data.stars <= 5)
                    || (request.resource.data.rating >= 1 && request.resource.data.rating <= 5);
      // Tidak ada ownerUid yang dapat dipercaya pada model testimonial saat ini.
      // Moderasi perubahan/penghapusan hanya melalui admin terotorisasi.
      allow update, delete: if request.auth != null
        && request.auth.token.email == 'admin@byaruna.my.id';
    }

    // =========================================================================
    // 4. THEME STUDIO - TEMA KUSTOM (/custom_themes)
    // =========================================================================
    match /custom_themes/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && (
          request.auth.token.email == 'admin@byaruna.my.id'
          || request.resource.data.ownerUid == request.auth.uid
        );
      allow update: if request.auth != null
        && (
          request.auth.token.email == 'admin@byaruna.my.id'
          || (
            resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == resource.data.ownerUid
          )
        );
      allow delete: if request.auth != null
        && (
          request.auth.token.email == 'admin@byaruna.my.id'
          || resource.data.ownerUid == request.auth.uid
        );
    }

    // =========================================================================
    // 5. PENGATURAN PLATFORM (/settings)
    // =========================================================================
    match /settings/{doc} {
      // Read publik untuk payment/announcement/packages/ads (dipakai form
      // order & banner) — KECUALI admin_auth: password admin TIDAK BOLEH
      // terbaca klien (login kini diverifikasi via /api/admin-login).
      allow read: if doc != 'admin_auth';
      // DITUTUP (P1 hardening): tulis settings kini lewat /api/admin-settings
      // (Admin SDK, verifikasi adminKey server-side). admin_auth juga tak
      // pernah bisa ditulis dari klien (password hanya via /api/admin-login).
      allow write: if false;
    }

    // =========================================================================
    // 6. KODE VOUCHER / PROMO (/vouchers)
    // =========================================================================
    match /vouchers/{code} {
      // Publik membaca diskon voucher (dipakai form order).
      // DITUTUP (P1 hardening): tulis voucher kini lewat /api/admin-settings
      // (Admin SDK, verifikasi adminKey server-side) — sebelumnya siapa pun
      // bisa membuat/menghapus kode diskon dari console browser.
      allow read: if true;
      allow write: if false;
    }
  }
}
