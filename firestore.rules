rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. KOLEKSI UNDANGAN (/invitations)
    // =========================================================================
    match /invitations/{slug} {
      // Tamu publik & pengantin bebas membuka undangan
      allow read: if true;

      // Siapa pun boleh membuat pesanan baru (harus 'unpaid') — tidak berubah
      allow create: if request.resource.data.status == 'unpaid'
                    || request.auth != null;

      // Pembaruan undangan — DITULIS ULANG (sebelumnya: siapa pun bisa menulis
      // field apa pun asal status tidak berubah).
      allow update: if
        // Kasus A: login Google pemilik/admin tercatat di dokumen (tetap)
        (request.auth != null && (resource.data.ownerUid == request.auth.uid || request.auth.token.email == resource.data.customerEmail))
        // Kasus C: admin platform (email yang sama dengan loginAdmin)
        || (request.auth != null && request.auth.token.email == 'admin@byaruna.my.id')
        // Kasus B: anonim hanya boleh menambah RSVP/wishes/views (alur tamu)
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rsvps', 'wishes', 'views'])
          && request.resource.data.status == resource.data.status
        );
      // Alur pelanggan & admin (foto, musik, banks, guests, balas ucapan,
      // tandai paid) TIDAK lewat sini — lewat /api/update-invitation dan
      // /api/delete-invitation (Admin SDK, sudah adopted).

      // DILINDUNGI (sebelumnya: akun Google APA PUN bisa menghapus): hanya
      // pemilik atau email admin tercatat di dokumen.
      allow delete: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid
        || request.auth.token.email == resource.data.customerEmail
      );
    }

    // =========================================================================
    // 2. BRANKAS KUNCI RAHASIA (/private_keys)
    // =========================================================================
    match /private_keys/{slug} {
      // DITUTUP (sebelumnya: akun Google apa pun bisa membaca seluruh editKey
      // klien). Verifikasi kunci kini lewat /api/verify-key (Admin SDK).
      allow read: if false;
      // Dibuat saat pesanan baru selesai dibuat (tidak berubah)
      allow create: if true;
      // Tidak ada alur sah yang mengubah brankas dari klien
      allow update, delete: if false;
    }

    // =========================================================================
    // 3. ULASAN & TESTIMONI PELANGGAN (/testimonials) — tidak berubah
    // =========================================================================
    match /testimonials/{id} {
      allow read: if true;
      allow create: if (request.resource.data.stars >= 1 && request.resource.data.stars <= 5)
                    || (request.resource.data.rating >= 1 && request.resource.data.rating <= 5);
      allow update, delete: if request.auth != null;
    }

    // =========================================================================
    // 4. THEME STUDIO - TEMA KUSTOM (/custom_themes) — tidak berubah (fitur
    //    publik ThemeStudio sedang dipakai; pengetatan menyusul terpisah)
    // =========================================================================
    match /custom_themes/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null;
    }

    // =========================================================================
    // 5. PENGATURAN PLATFORM (/settings)
    // =========================================================================
    match /settings/{doc} {
      // Read tetap terbuka: loginAdmin & banner pengumuman membaca dari klien.
      // Write: SEMENTARA mengikuti perilaku lama (buka) demi alur admin sesi
      // password-kustom yang tidak punya Firebase session. PENGETATAN P1:
      // pindahkan save settings/vouchers lewat serverless (Admin SDK).
      allow read: if true;
      allow write: if true;
    }

    // =========================================================================
    // 6. KODE VOUCHER / PROMO (/vouchers)
    // =========================================================================
    match /vouchers/{code} {
      // Publik membaca diskon voucher (dipakai form order). Write: sementara
      // perilaku lama — lihat catatan P1 di section 5.
      allow read: if true;
      allow write: if true;
    }
  }
}
