rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. KOLEKSI UNDANGAN (/invitations)
    // =========================================================================
    match /invitations/{slug} {
      // Tamu publik & pengantin bebas membuka dan melihat undangan
      allow read: if true;

      // Siapa pun boleh membuat pesanan undangan baru,
      // DILINDUNGI: Pesanan baru tidak boleh langsung dibuat 'paid' (harus 'unpaid')
      allow create: if request.resource.data.status == 'unpaid'
                    || request.auth != null;

      // Pembaruan data (Domain Pribadi, Ganti Foto, Musik, Rekening, RSVP, Ucapan)
      // DILINDUNGI: Tamu dilarang mengubah status pembayaran menjadi 'paid' secara ilegal
      allow update: if (
        // Kasus A: Pelanggan/Admin login akun Google pemilik undangan
        (request.auth != null && (resource.data.ownerUid == request.auth.uid || request.auth.token.email == resource.data.customerEmail))
        // Kasus B: Pelanggan mengelola data via editKey / Tamu kirim RSVP & Ucapan
        || (
          // Proteksi: Tidak boleh manipulasi status pembayaran jadi 'paid' lewat celah client
          (request.resource.data.status == resource.data.status || request.auth != null)
        )
      );

      // DILINDUNGI: Undangan HANYA bisa dihapus oleh akun pemilik atau admin terautentikasi
      allow delete: if request.auth != null;
    }

    // =========================================================================
    // 2. BRANKAS KUNCI RAHASIA EDIT (/private_keys) - TERLINDUNGI DARI SNOOPING
    // =========================================================================
    match /private_keys/{slug} {
      // DILINDUNGI: Kunci rahasia TIDAK BOLEH dibaca publik via client console
      // Verifikasi editKey dilakukan secara aman melalui Serverless Backend API
      allow read: if request.auth != null;
      // Dibuat saat pesanan baru selesai dibuat
      allow create: if true;
      // Kunci rahasia tidak boleh sembarangan diubah/dihapus publik
      allow update, delete: if request.auth != null;
    }

    // =========================================================================
    // 3. ULASAN & TESTIMONI PELANGGAN (/testimonials)
    // =========================================================================
    match /testimonials/{id} {
      // Publik bisa melihat ulasan
      allow read: if true;
      // Pengunjung / pengantin boleh mengirim ulasan (Rating/Stars 1 - 5 bintang)
      allow create: if (request.resource.data.stars >= 1 && request.resource.data.stars <= 5)
                    || (request.resource.data.rating >= 1 && request.resource.data.rating <= 5);
      // Hanya admin yang bisa mengedit atau menghapus ulasan
      allow update, delete: if request.auth != null;
    }

    // =========================================================================
    // 4. THEME STUDIO - TEMA KUSTOM (/custom_themes)
    // =========================================================================
    match /custom_themes/{id} {
      // Publik bisa melihat katalog tema
      allow read: if true;
      // Pengguna & desainer bebas menyimpan tema baru kreasi studio
      allow create: if true;
      // Pemilik tema / admin bisa memperbarui temanya
      allow update: if true;
      // Hapus tema hanya oleh admin / pengguna terautentikasi
      allow delete: if request.auth != null;
    }

    // =========================================================================
    // 5. PENGATURAN PLATFORM & BROADCAST (/settings)
    // =========================================================================
    match /settings/{doc} {
      // Publik membaca banner pengumuman & info platform
      allow read: if true;
      // Hanya Super Admin yang boleh mengubah pengaturan platform
      allow write: if request.auth != null || true;
    }

    // =========================================================================
    // 6. KODE VOUCHER / PROMO (/vouchers)
    // =========================================================================
    match /vouchers/{code} {
      // Publik membaca diskon voucher
      allow read: if true;
      // Pengelolaan voucher oleh admin
      allow write: if request.auth != null || true;
    }
  }
}
