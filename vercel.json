{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/create-invitation", "destination": "/api/invitation?route=create-invitation" },
    { "source": "/api/update-invitation", "destination": "/api/invitation?route=update-invitation" },
    { "source": "/api/delete-invitation", "destination": "/api/invitation?route=delete-invitation" },
    { "source": "/api/verify-key", "destination": "/api/invitation?route=verify-key" },
    { "source": "/api/admin-login", "destination": "/api/admin?route=admin-login" },
    { "source": "/api/admin-settings", "destination": "/api/admin?route=admin-settings" },
    { "source": "/api/admin-invitations", "destination": "/api/admin?route=admin-invitations" },
    { "source": "/api/notify-telegram", "destination": "/api/telegram?route=notify-telegram" },
    { "source": "/api/telegram-webhook", "destination": "/api/telegram?route=telegram-webhook" },
    { "source": "/u/:slug*", "destination": "/api/og?slug=$1" },
    { "source": "/((?!api/|sitemap\\.xml|robots\\.txt).*)", "destination": "/api/og?path=$1" },
    { "source": "/api/add-domain", "destination": "/api/domain?action=add" },
    { "source": "/api/remove-domain", "destination": "/api/domain?action=remove" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    }
  ],
  "functions": {
    "api/og.js": {
      "maxDuration": 10,
      "memory": 1024,
      "includeFiles": "dist/index.html"
    }
  }
}
