{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/u/:slug*", "destination": "/api/og?slug=$1" },
    { "source": "/((?!api/|sitemap\\.xml|robots\\.txt).*)", "destination": "/api/og?path=$1" },
    { "source": "/api/add-domain", "destination": "/api/domain?action=add" },
    { "source": "/api/remove-domain", "destination": "/api/domain?action=remove" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    }
  ],
  "functions": {
    "api/og.js": {
      "maxDuration": 10,
      "memory": 1024,
      "includeFiles": "dist/index.html"
    }
  }
}
