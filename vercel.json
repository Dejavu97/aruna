{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/u/:slug*", "destination": "/api/og?slug=$1" },
    { "source": "/((?!api/|sitemap\\.xml|robots\\.txt).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/og.js": {
      "maxDuration": 10,
      "memory": 1024,
      "includeFiles": "dist/index.html"
    }
  }
}
